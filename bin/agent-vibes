#!/usr/bin/env node
/**
 * agent-vibes CLI — Unified Agent Gateway
 *
 * Usage:
 *   agent-vibes                          Start the gateway server
 *   agent-vibes cert                     Generate SSL certificates
 *   agent-vibes sync --ide|--tools [--accounts-file PATH]
 *                                         Sync Antigravity credentials
 *   agent-vibes sync --claude [--accounts-file PATH]
 *                                         Sync Claude Code third-party credentials
 *   agent-vibes sync --codex [--accounts-file PATH]
 *                                         Sync Codex credentials
 *   agent-vibes forward hosts|on|off|status
 *   agent-vibes sync --deploy [--run]    Deploy credentials to GitHub Secrets
 *   agent-vibes --version                Show version
 *   agent-vibes --help                   Show help
 */

const path = require("path")
const fs = require("fs")
const os = require("os")
const forge = require("node-forge")
const { spawnSync } = require("child_process")

function buildAuthorityKeyIdentifierExtension(keyIdentifierBytes) {
  return {
    id: "2.5.29.35",
    critical: false,
    value: forge.asn1.toDer(
      forge.asn1.create(
        forge.asn1.Class.UNIVERSAL,
        forge.asn1.Type.SEQUENCE,
        true,
        [
          forge.asn1.create(
            forge.asn1.Class.CONTEXT_SPECIFIC,
            0,
            false,
            keyIdentifierBytes
          ),
        ]
      )
    ).getBytes(),
  }
}

const ROOT = path.resolve(__dirname, "..")
const rawArgs = process.argv.slice(2)

function pickOption(argv, longName) {
  const equalsPrefix = `${longName}=`
  for (let index = 0; index < argv.length; index++) {
    const arg = argv[index]
    if (arg === longName) {
      return argv[index + 1]
    }
    if (typeof arg === "string" && arg.startsWith(equalsPrefix)) {
      return arg.slice(equalsPrefix.length)
    }
  }
  return undefined
}

function stripOption(argv, longName) {
  const equalsPrefix = `${longName}=`
  const nextArgs = []
  for (let index = 0; index < argv.length; index++) {
    const arg = argv[index]
    if (arg === longName) {
      index += 1
      continue
    }
    if (typeof arg === "string" && arg.startsWith(equalsPrefix)) {
      continue
    }
    nextArgs.push(arg)
  }
  return nextArgs
}

const modeArg = pickOption(rawArgs, "--mode")
const apisConfigArg = pickOption(rawArgs, "--apis-config")
const args = stripOption(stripOption(rawArgs, "--mode"), "--apis-config")
const command = args[0]

// --version
if (args.includes("--version") || args.includes("-v")) {
  const pkg = JSON.parse(
    fs.readFileSync(
      path.join(ROOT, "apps", "protocol-bridge", "package.json"),
      "utf-8"
    )
  )
  console.log(`agent-vibes v${pkg.version}`)
  process.exit(0)
}

// --help
if (
  command === "help" ||
  command === "--help" ||
  command === "-h" ||
  (!command && (args.includes("--help") || args.includes("-h")))
) {
  console.log(`
agent-vibes — Unified Agent Gateway

Enables Claude Code CLI and Cursor IDE to use Antigravity AI backends
through protocol translation.

Usage:
  agent-vibes [--mode MODE] [--apis-config PATH]
                                      Start the gateway server
  agent-vibes --version               Show version
  agent-vibes --help                  Show help

Configuration:
  Runtime:
    --mode MODE                       Routing mode: standard | direct
    --apis-config PATH                Path to direct-mode apis.yaml / apis.yml

  Antigravity:
    agent-vibes sync --ide            Sync credentials from Antigravity IDE
    agent-vibes sync --tools          Sync credentials from Antigravity Manager
  Claude:
    agent-vibes sync --claude         Sync credentials from Claude Code settings
  Codex:
    agent-vibes sync --codex          Sync credentials from Codex CLI auth.json

  All sync commands support:
    --accounts-file PATH              Write to a specific accounts JSON file
  Cursor:
    agent-vibes cert                  Generate SSL certificates (requires mkcert)
    agent-vibes forward hosts         Print /etc/hosts entries
    agent-vibes forward on            Enable port forwarding (requires sudo)
    agent-vibes forward off           Disable port forwarding (requires sudo)
    agent-vibes forward status        Show forwarding status

Deployment:
  agent-vibes sync --deploy           Deploy credentials to GitHub Secrets
  agent-vibes sync --deploy --run     Deploy + trigger CI/CD workflow

Advanced:
  agent-vibes patch                   Patch Cursor binary for proxy
  agent-vibes patch --restore         Restore original Cursor binary
  agent-vibes patch --status          Check Cursor patch status
  agent-vibes capture start           Start traffic capture (Clash + mitmdump)
  agent-vibes capture stop            Stop traffic capture
  agent-vibes capture status          Show capture status
  agent-vibes capture repair          Repair stale capture injection
  agent-vibes issues                  Collect diagnostics for bug reports

Documentation: https://github.com/funny-vibes/agent-vibes
`)
  process.exit(0)
}

function run(commandName, commandArgs, opts = {}) {
  const result = spawnSync(commandName, commandArgs, {
    cwd: ROOT,
    stdio: "inherit",
    ...opts,
  })
  if (result.error) {
    console.error(result.error.message)
    process.exit(1)
  }
  process.exit(result.status ?? 1)
}

function nodeScript(scriptPath, scriptArgs = [], opts = {}) {
  run(process.execPath, [path.join(ROOT, scriptPath), ...scriptArgs], opts)
}

function tsxScript(scriptPath, scriptArgs = [], opts = {}) {
  run(
    process.execPath,
    ["--import", "tsx", path.join(ROOT, scriptPath), ...scriptArgs],
    opts
  )
}

if (command === "sync") {
  if (args.includes("--deploy")) {
    nodeScript("scripts/accounts/sync-deploy.js", args.slice(1))
  } else if (args.includes("--claude")) {
    nodeScript(
      "scripts/accounts/sync-claude-account.js",
      args.slice(1).filter((arg) => arg !== "--claude")
    )
  } else if (args.includes("--codex")) {
    nodeScript(
      "scripts/accounts/sync-codex-account.js",
      args.slice(1).filter((arg) => arg !== "--codex")
    )
  } else {
    nodeScript("scripts/accounts/sync-antigravity-accounts.js", args.slice(1))
  }
}

const CURSOR_CERT_HOSTS = [
  "localhost",
  "*.api5.cursor.sh",
  "*.cursor.sh",
  "api2.cursor.sh",
  "api2geo.cursor.sh",
  "api2direct.cursor.sh",
  "agent.api2.cursor.sh",
  "agentn.api2.cursor.sh",
  "agent.api2geo.cursor.sh",
  "agentn.api2geo.cursor.sh",
  "agent.api2direct.cursor.sh",
  "agentn.api2direct.cursor.sh",
  "agent.api5.cursor.sh",
  "agentn.api5.cursor.sh",
  "agent.api5geo.cursor.sh",
  "agent.api5lat.cursor.sh",
  "agentn.api5geo.cursor.sh",
  "agentn.api5lat.cursor.sh",
  "agent-gcpp-uswest.api5.cursor.sh",
  "agent-gcpp-eucentral.api5.cursor.sh",
  "agent-gcpp-apsoutheast.api5.cursor.sh",
  "agentn-gcpp-uswest.api5.cursor.sh",
  "agentn-gcpp-eucentral.api5.cursor.sh",
  "agentn-gcpp-apsoutheast.api5.cursor.sh",
  "agent.us.api5.cursor.sh",
  "agent.eu.api5.cursor.sh",
  "agent.ap.api5.cursor.sh",
  "agentn.us.api5.cursor.sh",
  "agentn.eu.api5.cursor.sh",
  "agentn.ap.api5.cursor.sh",
  "a.cursor.sh",
  "127.0.0.1",
  "127.0.0.2",
  "127.0.0.3",
  "::1",
]

function getAgentVibesDataDir() {
  return process.env.AGENT_VIBES_DATA_DIR || path.join(os.homedir(), ".agent-vibes")
}

function getAgentVibesCertDir() {
  return path.join(getAgentVibesDataDir(), "certs")
}

function ensureNodeExtraCaCerts(caCertPath) {
  process.env.NODE_EXTRA_CA_CERTS = caCertPath

  if (process.platform === "win32") {
    return spawnSync("setx", ["NODE_EXTRA_CA_CERTS", caCertPath], {
      encoding: "utf-8",
      stdio: "pipe",
    })
  }

  const marker = "# Added by agent-vibes cert (Electron/Node.js CA trust)"
  const exportLine = `export NODE_EXTRA_CA_CERTS="${caCertPath}"`
  const profiles = process.platform === "darwin"
    ? [".zshrc", ".bashrc", ".bash_profile"]
    : [".bashrc", ".profile", ".zshrc"]
  const home = os.homedir()
  const targetProfile = profiles
    .map((name) => path.join(home, name))
    .find((profile) => fs.existsSync(profile)) || path.join(home, profiles[0])
  const currentContent = fs.existsSync(targetProfile)
    ? fs.readFileSync(targetProfile, "utf-8")
    : ""
  const lines = currentContent
    .split(/\r?\n/)
    .filter((line) => !line.includes("NODE_EXTRA_CA_CERTS") && !line.includes(marker))
    .filter((line, index, arr) => !(index === arr.length - 1 && line === ""))
  const nextContent = `${lines.join("\n")}\n${marker}\n${exportLine}\n`

  fs.writeFileSync(targetProfile, nextContent)
  return { status: 0, stdout: targetProfile, stderr: "" }
}

function installCaToSystemTrust(caCertPath) {
  if (process.platform === "win32") {
    return spawnSync(
      "powershell",
      [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        `Import-Certificate -FilePath '${caCertPath.replace(/'/g, "''")}' -CertStoreLocation Cert:\\LocalMachine\\Root`,
      ],
      { encoding: "utf-8", stdio: "inherit" }
    )
  }

  if (process.platform === "darwin") {
    return spawnSync(
      "sudo",
      [
        "security",
        "add-trusted-cert",
        "-d",
        "-r",
        "trustRoot",
        "-k",
        "/Library/Keychains/System.keychain",
        caCertPath,
      ],
      { encoding: "utf-8", stdio: "inherit" }
    )
  }

  if (fs.existsSync("/usr/local/share/ca-certificates")) {
    return spawnSync(
      "sudo",
      [
        "sh",
        "-c",
        `cp '${caCertPath.replace(/'/g, "'\\''")}' /usr/local/share/ca-certificates/agent-vibes-ca.crt && update-ca-certificates`,
      ],
      { encoding: "utf-8", stdio: "inherit" }
    )
  }

  if (fs.existsSync("/etc/pki/ca-trust/source/anchors")) {
    return spawnSync(
      "sudo",
      [
        "sh",
        "-c",
        `cp '${caCertPath.replace(/'/g, "'\\''")}' /etc/pki/ca-trust/source/anchors/agent-vibes-ca.pem && update-ca-trust extract`,
      ],
      { encoding: "utf-8", stdio: "inherit" }
    )
  }

  return { status: 1 }
}

function generateCertificates() {
  const certDir = getAgentVibesCertDir()
  fs.mkdirSync(certDir, { recursive: true })

  const caKeys = forge.pki.rsa.generateKeyPair(2048)
  const caCert = forge.pki.createCertificate()
  caCert.publicKey = caKeys.publicKey
  caCert.serialNumber = String(Date.now())
  caCert.validity.notBefore = new Date()
  caCert.validity.notAfter = new Date()
  caCert.validity.notAfter.setFullYear(caCert.validity.notBefore.getFullYear() + 10)

  const caAttrs = [
    { name: "commonName", value: "Agent Vibes Local CA" },
    { name: "organizationName", value: "Agent Vibes" },
  ]
  caCert.setSubject(caAttrs)
  caCert.setIssuer(caAttrs)
  caCert.setExtensions([
    { name: "basicConstraints", cA: true },
    { name: "keyUsage", keyCertSign: true, cRLSign: true },
      { name: "subjectKeyIdentifier" },
  ])
  caCert.sign(caKeys.privateKey, forge.md.sha256.create())
  const caSubjectKeyIdentifierExtension = caCert.getExtension("subjectKeyIdentifier")
  const caSubjectKeyIdentifierHex = caSubjectKeyIdentifierExtension?.subjectKeyIdentifier

  if (!caSubjectKeyIdentifierHex) {
    throw new Error("Failed to derive CA subject key identifier")
  }

  const caSubjectKeyIdentifierBytes = forge.util.hexToBytes(caSubjectKeyIdentifierHex)

  const serverKeys = forge.pki.rsa.generateKeyPair(2048)
  const serverCert = forge.pki.createCertificate()
  serverCert.publicKey = serverKeys.publicKey
  serverCert.serialNumber = String(Date.now() + 1)
  serverCert.validity.notBefore = new Date()
  serverCert.validity.notAfter = new Date()
  serverCert.validity.notAfter.setFullYear(serverCert.validity.notBefore.getFullYear() + 2)

  const serverAttrs = [
    { name: "commonName", value: "localhost" },
    { name: "organizationName", value: "Agent Vibes" },
  ]
  const altNames = CURSOR_CERT_HOSTS.map((host) => {
    if (/^\d+\.\d+\.\d+\.\d+$/.test(host) || host === "::1") {
      return { type: 7, ip: host }
    }
    return { type: 2, value: host }
  })

  serverCert.setSubject(serverAttrs)
  serverCert.setIssuer(caAttrs)
  serverCert.setExtensions([
    { name: "basicConstraints", cA: false },
    { name: "keyUsage", digitalSignature: true, keyEncipherment: true },
    { name: "extKeyUsage", serverAuth: true },
    { name: "subjectAltName", altNames },
    buildAuthorityKeyIdentifierExtension(caSubjectKeyIdentifierBytes),
    { name: "subjectKeyIdentifier" },
  ])
  serverCert.sign(caKeys.privateKey, forge.md.sha256.create())

  const caCertPath = path.join(certDir, "ca.pem")
  const caKeyPath = path.join(certDir, "ca-key.pem")
  const serverCertPath = path.join(certDir, "server.pem")
  const serverKeyPath = path.join(certDir, "server-key.pem")

  fs.writeFileSync(caCertPath, forge.pki.certificateToPem(caCert))
  fs.writeFileSync(caKeyPath, forge.pki.privateKeyToPem(caKeys.privateKey))
  fs.writeFileSync(serverCertPath, forge.pki.certificateToPem(serverCert))
  fs.writeFileSync(serverKeyPath, forge.pki.privateKeyToPem(serverKeys.privateKey))

  return { caCertPath, serverCertPath, serverKeyPath }
}

if (command === "cert") {
  const GREEN = "\x1b[0;32m"
  const RED = "\x1b[0;31m"
  const YELLOW = "\x1b[1;33m"
  const CYAN = "\x1b[0;36m"
  const NC = "\x1b[0m"

  console.log(`\n${CYAN}▸ Generating SSL certificates...${NC}`)
  const { caCertPath, serverCertPath, serverKeyPath } = generateCertificates()

  console.log(`\n${CYAN}▸ Installing CA into system trust store...${NC}`)
  const trustResult = installCaToSystemTrust(caCertPath)
  if (trustResult.status !== 0) {
    console.log(`${YELLOW}⚠ Automatic system trust installation did not complete.${NC}`)
  }

  console.log(`\n${CYAN}▸ Configuring NODE_EXTRA_CA_CERTS for Cursor (Electron/Node.js)...${NC}`)
  const envResult = ensureNodeExtraCaCerts(caCertPath)
  if (envResult.status !== 0) {
    console.error(`${RED}✗ NODE_EXTRA_CA_CERTS configuration failed${NC}`)
    process.exit(1)
  }

  console.log(`\n${CYAN}═══ Certificate Setup Summary ═══${NC}`)
  console.log(`  CA Root:     ${GREEN}${caCertPath}${NC}`)
  console.log(`  Certificate: ${fs.existsSync(serverCertPath) ? GREEN + "✓" : RED + "✗"} ${serverCertPath}${NC}`)
  console.log(`  Key:         ${fs.existsSync(serverKeyPath) ? GREEN + "✓" : RED + "✗"} ${serverKeyPath}${NC}`)

  console.log("")
  if (trustResult.status !== 0) {
    if (process.platform === "win32") {
      console.log(`${YELLOW}Windows:${NC} Please rerun this command in an elevated terminal if Cursor still does not trust the CA.`)
    } else if (process.platform === "darwin") {
      console.log(`${YELLOW}macOS:${NC} You may need to trust the CA manually in Keychain Access or rerun with sudo support.`)
    } else {
      console.log(`${YELLOW}Linux:${NC} You may need to rerun with sudo so the CA can be copied into the system trust store.`)
    }
  }
  console.log(`${YELLOW}Important:${NC} Restart Cursor for the certificate changes to take effect.`)
  console.log("")

  process.exit(0)
}

if (command === "patch") {
  tsxScript("scripts/cursor/patch_transport.ts", args.slice(1), {
    env: {
      ...process.env,
      NO_PROXY: "127.0.0.1,localhost,127.0.0.2,*.cursor.sh,*.azureedge.net",
    },
  })
}

if (command === "forward") {
  const subCmd = args[1] || "status"
  if (subCmd === "on" || subCmd === "off") {
    if (process.platform === "win32") {
      // Windows: node script checks for admin internally
      nodeScript("scripts/proxy/setup-forwarding.js", [subCmd])
    } else {
      run("sudo", [process.execPath, path.join(ROOT, "scripts/proxy/setup-forwarding.js"), subCmd])
    }
  } else {
    nodeScript("scripts/proxy/setup-forwarding.js", [subCmd])
  }
}

if (command === "issues") {
  nodeScript("scripts/diagnostics/collect-issue-logs.js", args.slice(1))
}

if (command === "capture") {
  const subCmd = args[1] || "status"
  if (process.platform === "win32") {
    // Windows: no sudo, scripts check elevation internally
    nodeScript("scripts/capture/capture.js", [subCmd])
  } else {
    run("sudo", [process.execPath, path.join(ROOT, "scripts/capture/capture.js"), subCmd])
  }
}

// Default: start server
const allowedModes = new Set(["standard", "direct"])
if (modeArg && !allowedModes.has(modeArg)) {
  console.error(`Error: Unsupported --mode value '${modeArg}'. Use 'standard' or 'direct'.`)
  process.exit(1)
}

if (modeArg) {
  process.env.AGENT_VIBES_ROUTING_MODE = modeArg
}
if (apisConfigArg) {
  process.env.AGENT_VIBES_APIS_CONFIG_PATH = path.resolve(apisConfigArg)
}

const mainPath = path.join(ROOT, "apps", "protocol-bridge", "dist", "main.js")

if (!fs.existsSync(mainPath)) {
  console.error(
    "Error: Server not built. Run 'npm run build' in apps/protocol-bridge first."
  )
  process.exit(1)
}

require(mainPath)
